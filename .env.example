# Personal OS — operator configuration.
#
# Copy to `.env.local` (local) or paste into your platform's environment UI
# (Coolify, Docker). Everything here is optional: with no credentials set the app
# runs in open mode, which is only appropriate on a loopback workstation.

# ---------------------------------------------------------------------------
# Operator account. There is no registration route — this credential is the only
# way in, and it can only exist in configuration.
# ---------------------------------------------------------------------------
# PERSONAL_OS_USERNAME=ctum
# PERSONAL_OS_PASSWORD_SALT=<16 random bytes, hex>
# PERSONAL_OS_PASSWORD_HASH=<pbkdf2-hmac-sha256(password, salt, iterations), hex>
# PERSONAL_OS_PASSWORD_ITERATIONS=210000
# PERSONAL_OS_SESSION_SECRET=<32 random bytes, hex>

# Generate all four with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log('PERSONAL_OS_PASSWORD_SALT='+s);console.log('PERSONAL_OS_PASSWORD_HASH='+c.pbkdf2Sync(process.argv[1],s,210000,32,'sha256').toString('hex'));console.log('PERSONAL_OS_SESSION_SECRET='+c.randomBytes(32).toString('hex'))" 'your-password'

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# SQLite file. In a container point this at a mounted volume (default /app/data).
# PERSONAL_OS_DB_PATH=/app/data/profile.db
# PERSONAL_OS_TZ=Asia/Colombo

# Keep the footprint small on a shared VPS: the app is a single Node process with
# an in-process SQLite handle, so a 256 MB heap ceiling is comfortable.
# NODE_OPTIONS=--max-old-space-size=256
