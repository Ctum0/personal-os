# Personal OS — configuration.
#
# Copy to .env for `docker compose up`, or set these in your platform's
# environment UI. Every value is required: the app refuses to start through
# compose without the four credential values below.
#
# Generate the credential values in one go (prints them for you to paste):
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');\
#   console.log('PERSONAL_OS_PASSWORD_SALT='+s);\
#   console.log('PERSONAL_OS_PASSWORD_HASH='+c.pbkdf2Sync(process.argv[1],s,210000,32,'sha256').toString('hex'));\
#   console.log('PERSONAL_OS_SESSION_SECRET='+c.randomBytes(32).toString('hex'))" 'your-password'

# --- Operator account -------------------------------------------------------
# One account, no registration route. This credential exists only here.
PERSONAL_OS_USERNAME=operator
PERSONAL_OS_PASSWORD_SALT=REPLACE_ME
PERSONAL_OS_PASSWORD_HASH=REPLACE_ME
PERSONAL_OS_PASSWORD_ITERATIONS=210000
PERSONAL_OS_SESSION_SECRET=REPLACE_ME

# --- Runtime ----------------------------------------------------------------
PERSONAL_OS_DB_PATH=/app/data/personal_os.db
PERSONAL_OS_TZ=Asia/Colombo

# Keeps the process small; the image is one Node process with an in-process
# SQLite handle.
NODE_OPTIONS=--max-old-space-size=256
NEXT_TELEMETRY_DISABLED=1
